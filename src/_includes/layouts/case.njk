---
layout: layouts/base.njk
---
{% set store = en.cases if lang == "en" else cases %}
{% set c = store[caseId] %}
<article class="case">
  <header class="case__header l-container">
    <a class="back-link" href="{{ '/en/work/' if lang == 'en' else '/work/' }}">{{ i18n[lang or 'ru'].back }}</a>
    <p class="case__kicker">{{ c.period }} · {{ c.role }}</p>
    <h1 class="case__title">{{ c.title }}</h1>
    <p class="case__subtitle">{{ c.subtitle }}</p>
    <p class="case__summary">{{ c.summary }}</p>
    <p class="case__stack">
      {% for tech in c.stack %}<span>{{ tech }}</span>{% endfor %}
    </p>
  </header>

  <div class="case__body">
    <section class="case__section">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_context }}</h2>
      <p class="prose">{{ c.context }}</p>
    </section>

    <section class="case__section">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_constraints }}</h2>
      <ul class="case__list">
        {% for item in c.constraints %}<li class="case__list-item">{{ item }}</li>{% endfor %}
      </ul>
    </section>

    <section class="case__section">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_decisions }}</h2>
      {% for d in c.decisions %}
      <article class="decision">
        <h3 class="decision__title">{{ d.title }}</h3>
        <dl class="decision__facts">
          <dt>{{ i18n[lang or 'ru'].label_options }}</dt>
          <dd>{{ d.options | join(" · ") }}</dd>
          <dt>{{ i18n[lang or 'ru'].label_choice }}</dt>
          <dd>{{ d.choice }}</dd>
          <dt>{{ i18n[lang or 'ru'].label_why }}</dt>
          <dd>{{ d.why }}</dd>
          <dt>{{ i18n[lang or 'ru'].label_cost }}</dt>
          <dd>{{ d.cost }}</dd>
        </dl>
      </article>
      {% endfor %}
    </section>

    <section class="case__section">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_result }}</h2>
      {% if c.no_metrics %}
      <p class="prose">{{ i18n[lang or 'ru'].no_metrics }}: {{ c.metrics[0].method }}.</p>
      {% else %}
      <dl class="metric-list">
        {% for m in c.metrics %}
        <div class="metric">
          <dt class="metric__label">{{ m.label }}</dt>
          <dd class="metric__value">
            {% if m.before %}<span class="metric__before">{{ m.before }}</span>
            <span class="metric__arrow" aria-hidden="true">→</span>{% endif %}
            <span class="metric__after">{{ m.after }}</span>
            {% if m.source %}
            <button class="footnote" type="button" popovertarget="fn-{{ c.slug }}-{{ loop.index }}" aria-label="Источник данных">{{ loop.index }}</button>
            {% endif %}
          </dd>
          <dd class="metric__method">{{ m.method }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% endif %}
    </section>

    {% if c.compare %}
    <section class="case__section case__section--bleed">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_before_after }}</h2>
      <figure class="compare js-compare">
        <img class="compare__img" src="{{ c.compare.after }}" alt="{{ c.compare.after_alt }}" width="1440" height="810" loading="lazy" decoding="async">
        <img class="compare__img compare__img--before" src="{{ c.compare.before }}" alt="{{ c.compare.before_alt }}" width="1440" height="810" loading="lazy" decoding="async">
        <span class="compare__hint" aria-hidden="true">{{ i18n[lang or 'ru'].compare_hint }}</span>
        <input class="compare__range" type="range" min="0" max="100" value="50" step="1" aria-label="Сравнение: до и после редизайна">
      </figure>
      <figcaption class="artifact__caption">{{ c.compare.caption }}</figcaption>
    </section>
    {% endif %}

    <section class="case__section case__section--bleed">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_artifacts }}</h2>
      {%- set pair = c.artifacts.length > 1 and c.artifacts[0].orientation == "portrait" %}
      <div class="artifact-grid{% if pair %} artifact-grid--pair{% endif %}">
        {% for a in c.artifacts %}
        <figure class="artifact artifact--{{ a.orientation }}">
          {%- set isPortrait = a.orientation == "portrait" %}
          <img class="artifact__image" src="{{ a.src }}" alt="{{ a.caption }}" width="{{ 540 if isPortrait else 1440 }}" height="{{ 1170 if isPortrait else 810 }}" loading="lazy" decoding="async">
          <figcaption class="artifact__caption">{{ a.caption }}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </section>

    <section class="case__section">
      <h2 class="case__section-title">{{ i18n[lang or 'ru'].case_sources }}</h2>
      <ul class="case__list case__list--plain">
        {% for s in c.sources %}<li class="case__list-item">{{ s }}</li>{% endfor %}
      </ul>
    </section>

    {% for m in c.metrics %}{% if m.source %}
    <div class="footnote-popover" id="fn-{{ c.slug }}-{{ loop.index }}" popover>
      <p>{{ m.label }}: {{ m.source }}</p>
    </div>
    {% endif %}{% endfor %}
  </div>
</article>
