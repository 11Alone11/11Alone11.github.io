<!DOCTYPE html>
<html lang="{{ lang or 'ru' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  {%- if altUrl %}
  <link rel="alternate" hreflang="{{ 'en' if lang == 'en' else 'ru' }}" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" hreflang="{{ 'ru' if lang == 'en' else 'en' }}" href="{{ site.url }}{{ altUrl }}">
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altUrl if lang == 'en' else page.url }}">
  {%- endif %}
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="{{ 'en_US' if lang == 'en' else 'ru_RU' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta property="og:site_name" content="{{ 'Anton Stasiuk' if lang == 'en' else 'Антон Стасюк' }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/img/og/og-home.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/img/og/og-home.png' }}">
  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/literata-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/css/styles.css?v={{ build.id }}">
  <script>
    (function () {
      var theme;
      try { theme = localStorage.getItem("theme"); } catch (e) {}
      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  {% include "partials/schema.njk" %}
</head>
<body class="page">
  <a class="skip-link" href="#main">{{ i18n[lang or 'ru'].skip }}</a>
  {% include "partials/header.njk" %}
  <main class="page__main" id="main">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  {% include "partials/palette.njk" %}
  <script type="module" src="/js/main.js?v={{ build.id }}"></script>
</body>
</html>
