<!DOCTYPE html>
<html lang="ru" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <meta property="og:type" content="website">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:locale" content="ru_RU">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/img/og/og-home.png' }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ title }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="{{ site.url }}{{ ogImage or '/img/og/og-home.png' }}">

  <link rel="icon" href="/img/favicon.svg" type="image/svg+xml">
  <link rel="preload" href="/fonts/literata-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/fonts/inter-cyrillic.woff2" as="font" type="font/woff2" crossorigin>

  <script>
    (function () {
      var root = document.documentElement;
      root.classList.remove("no-js");
      root.classList.add("js");
      var theme;
      try { theme = localStorage.getItem("theme"); } catch (e) {}
      if (theme !== "light" && theme !== "dark") {
        theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      root.dataset.theme = theme;
    })();
  </script>

  <link rel="stylesheet" href="/css/styles.css?v={{ build.id }}">
  {% include "partials/schema.njk" %}
</head>
<body id="top" class="page">
  <div class="progress" aria-hidden="true"><span class="js-progress"></span></div>
  <a class="skip-link" href="#main">Перейти к содержанию</a>

  {% include "partials/header.njk" %}

  <main class="page__main" id="main">
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}
  {% include "partials/lightbox.njk" %}

  <script type="module" src="/js/main.js?v={{ build.id }}"></script>
</body>
</html>
