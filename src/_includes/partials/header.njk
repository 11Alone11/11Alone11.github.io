<header class="site-header js-header">
  <div class="l-container site-header__inner">
    <a class="brand" href="#top" aria-label="Антон Стасюк — наверх">
      <span class="brand__mark" aria-hidden="true">АС</span>
      <span class="brand__name">Антон Стасюк</span>
    </a>

    <nav class="nav" aria-label="Разделы">
