<dialog class="lightbox js-lightbox-dialog" aria-labelledby="lightbox-title" aria-describedby="lightbox-caption">
  <h2 class="visually-hidden" id="lightbox-title">Просмотр скриншота</h2>
  <div class="lightbox__bar">
    <p class="lightbox__counter js-lightbox-counter">1 / 1</p>
    <button class="lightbox__close js-lightbox-close" type="button" aria-label="Закрыть просмотр">
      <span aria-hidden="true">×</span>
    </button>
  </div>
  <figure class="lightbox__figure">
    <img class="lightbox__img js-lightbox-img" src="" alt="">
    <figcaption class="lightbox__caption" id="lightbox-caption"></figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--prev js-lightbox-prev" type="button" aria-label="Предыдущий скриншот">
    <span aria-hidden="true">←</span>
  </button>
  <button class="lightbox__nav lightbox__nav--next js-lightbox-next" type="button" aria-label="Следующий скриншот">
    <span aria-hidden="true">→</span>
  </button>
</dialog>
