<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "{{ site.url }}/#person",
      "name": "{{ site.name }}",
      "alternateName": "Anton Stasiuk",
      "url": "{{ site.url }}",
      "jobTitle": "Frontend-разработчик",
      "email": "mailto:{{ site.email }}",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Минск",
        "addressCountry": "BY"
      },
      "sameAs": ["{{ site.github }}", "{{ site.telegram }}"],
      "knowsAbout": ["TypeScript", "JavaScript", "Vue 3", "Nuxt", "React", "Redux Toolkit", "TanStack Query", "Pinia", "HTML", "CSS", "SEO", "Core Web Vitals"]
    },
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}",
      "name": "{{ site.name }} — портфолио",
      "inLanguage": "ru",
      "publisher": { "@id": "{{ site.url }}/#person" }
    },
    {
      "@type": "ProfilePage",
      "@id": "{{ site.url }}/#profile",
      "url": "{{ site.url }}/",
      "name": "{{ site.name }} — Frontend-разработчик",
      "inLanguage": "ru",
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "about": { "@id": "{{ site.url }}/#person" },
      "mainEntity": { "@id": "{{ site.url }}/#person" }
    }
  ]
}
</script>
